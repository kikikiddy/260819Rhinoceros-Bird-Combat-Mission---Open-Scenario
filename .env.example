# Hy3 / 裁判模型调用配置（复制为 .env 后填写真实值，切勿提交 .env）
# 本项目评测使用的默认网关：qnaigc OpenAI 兼容端点
HY3_API_KEY=YOUR_HY3_KEY_HERE
HY3_BASE_URL=https://api.qnaigc.com/v1
HY3_MODEL=tencent/hy3-preview

# 裁判模型（LLM-as-judge，负责 D4 法律依据 / D6 用户可理解 等主观维度）
# 与被评模型解耦，避免"自评偏置"；可替换为任意 OpenAI 兼容端点
JUDGE_API_KEY=YOUR_JUDGE_KEY_HERE
JUDGE_BASE_URL=https://api.qnaigc.com/v1
JUDGE_MODEL=z-ai/glm-5.3

# 调用参数
HY3_TIMEOUT=90
HY3_MAX_RETRIES=3
HY3_MIN_INTERVAL=0.2

# 说明：若改为本地自部署（vLLM/SGLang），将 BASE_URL 改回 http://127.0.0.1:8000/v1、
# API_KEY 填 EMPTY、MODEL 填 hy3 即可，其余不变。
